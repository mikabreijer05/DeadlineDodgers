@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Hero Banner Deal Section -->
<section class="deals-hero">
    <div class="deals-hero-content">
        <div class="deals-hero-text">
            <h2 class="deals-hero-title">⚡ MEGA DEALS ⚡</h2>
            <p class="deals-hero-subtitle">Tot 50% korting op geselecteerde items</p>
            <a href="#deals-section" class="deals-btn">BEKIJK DEALS</a>
        </div>
        <div class="deals-hero-visual">
            <div class="discount-badge discount-badge-1">50%</div>
            <div class="discount-badge discount-badge-2">30%</div>
            <div class="discount-badge discount-badge-3">40%</div>
        </div>
    </div>
</section>

<!-- Deal Cards Section -->
<section id="deals-section" class="deals-section">
    <h2 class="deals-section-title">> HUIDIGE AANBIEDINGEN</h2>

    <div class="deals-grid">
        <!-- Deal Card 1 -->
        <div class="deal-card">
            <div class="deal-badge">-50%</div>
            <div class="deal-content">
                <h3>Red Pill Special</h3>
                <p class="deal-description">Onthul de waarheid met korting</p>
                <div class="deal-price">
                    <span class="original-price">€0,99</span>
                    <span class="sale-price">€0,47</span>
                </div>
            </div>
            <a href="@Url.Page("/ProductPagina", new { id = 3 })" class="deal-cta">SHOP NOW →</a>
        </div>

        <!-- Deal Card 2 -->
        <div class="deal-card">
            <div class="deal-badge">-50%</div>
            <div class="deal-content">
                <h3>Blue Pill Bonus</h3>
                <p class="deal-description">Blijf in comfort met korting</p>
                <div class="deal-price">
                    <span class="original-price">€9,00</span>
                    <span class="sale-price">€4,50</span>
                </div>
            </div>
            <a href="@Url.Page("/ProductPagina", new { id = 2 })" class="deal-cta">SHOP NOW →</a>
        </div>

        <!-- Deal Card 3 -->
        <div class="deal-card">
            <div class="deal-badge">-25%</div>
            <div class="deal-content">
                <h3>Hovercraft Sale</h3>
                <p class="deal-description">Vliegen door het systeem</p>
                <div class="deal-price">
                    <span class="original-price">€1000,00</span>
                    <span class="sale-price">€749,99</span>
                </div>
            </div>
            <a href="@Url.Page("/ProductPagina", new { id = 1 })" class="deal-cta">SHOP NOW →</a>
        </div>

        <!-- Deal Card 4 -->
        <div class="deal-card">
            <div class="deal-badge">-10%</div>
            <div class="deal-content">
                <h3>Boutje Sale</h3>
                <p class="deal-description">Perfectie in beweging</p>
                <div class="deal-price">
                    <span class="original-price">€0,50</span>
                    <span class="sale-price">€0,40</span>
                </div>
            </div>
            <a href="@Url.Page("/ProductPagina", new { id = 4 })" class="deal-cta">SHOP NOW →</a>
        </div>
    </div>
</section>

<section>
    <h1>ALLE ITEMS</h1>

    <div class="product-grid">
        @foreach (var product in Model.Products)
        {
            <div class="product-card"
                 onclick="window.location.href='@Url.Page("/ProductPagina", new { id = product.Id })'">
                <img src="@product.ImageUrl" alt="@product.Name">
                <h3>@product.Name</h3>
                <p>€@product.Price</p>
                <div class="product-rating">
                    @await Html.PartialAsync("_Rating", product.AverageRating)
                </div>
                <div class="quantity-selector">
                    <button class="qty-btn qty-minus" onclick="event.stopPropagation()">−</button>
                    <input type="number" class="qty-input" value="1" min="1" max="999" readonly onclick="event.stopPropagation()">
                    <button class="qty-btn qty-plus" onclick="event.stopPropagation()">+</button>
                </div>
                <button class="add-btn"
                        data-product-id="@product.Id"
                        data-product-name="@product.Name"
                        data-product-price="@product.Price"
                        onclick="event.stopPropagation()">
                    🛒 in winkelwagen
                </button>
            </div>
        }
    </div>

</section>



