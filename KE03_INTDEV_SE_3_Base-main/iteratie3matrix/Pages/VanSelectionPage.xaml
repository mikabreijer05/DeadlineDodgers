<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="iteratie3matrix.Pages.VanSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:iteratie3matrix.PageModels"
    xmlns:models="clr-namespace:iteratie3matrix.Models"
    x:DataType="pageModels:VanSelectionPageModel"
    Title="Dienst starten">

    <Grid Padding="20">

        <VerticalStackLayout Spacing="15">

            <!-- PAGE TITLE -->
            <Label
                Text="Voertuig selecteren"
                FontSize="24"
                FontAttributes="Bold" />

            <!-- TAB PLACEHOLDER -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                Margin="0,20,0,0">

                <!-- Vandaag -->
                <Button
                    Grid.Column="0"
                    Text="Vandaag"
                    TextColor="Black"
                    Command="{Binding TodayCommand}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <!-- Rooster -->
                <Button
                    Grid.Column="1"
                    Text="Rooster"
                    TextColor="Black"
                    Command="{Binding ScheduleCommand}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

            </Grid>

            <!-- TODAY VEHICLES -->
            <Label
                Text="Beschikbare voertuigen"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Vans}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Van">

                        <Border
                            Padding="15"
                            Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="2">

                                <!-- VAN NAME -->
                                <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <!-- PARKING LOCATION -->
                                <Label
                                    Text="{Binding ParkingLocation,
                                                   StringFormat='Locatie: {0}'}"
                                    Opacity="0.8" />

                                <!-- LICENSE PLATE -->
                                <Label
                                    Text="{Binding LicensePlate,
                                                   StringFormat='Kenteken: {0}'}"
                                    FontAttributes="Bold"
                                    TextColor="#7FFF7F" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- START SHIFT -->
            <Button
                Text="Dienst starten"
                BackgroundColor="#00FF41"
                TextColor="Black"
                Command="{Binding StartShiftCommand}" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>